# ---- Taxi Cyprus configuration (no secrets committed) ----
# PostgreSQL connection (server-only)
DATABASE_URL=postgresql://taxi:CHANGE_ME@localhost:5432/taxi_cyprus?schema=public

# Public base URL of the beta
APP_BASE_URL=https://cyprustaxi.ackedberryes.store

# Server-only secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_64_HEX
TRACKING_RECEIPT_SECRET=CHANGE_ME_64_HEX

# Demo / live behaviour. DEMO_MODE=true uses fixture places + opt-in simulated vehicle.
DEMO_MODE=true

# Map rendering (real MapLibre renderer). Raster demo tiles by default.
# For production, configure an authorized vector style + key server-side.
NEXT_PUBLIC_MAP_STYLE=demo-raster
NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Geocoder / router adapters (optional). Empty = demo fixtures.
GEOCODER_PROVIDER=
GEOCODER_URL=
ROUTER_PROVIDER=
ROUTER_URL=

# Scheduling + GPS engineering defaults (configurable, SPEC §3/§6)
SCHEDULE_MIN_MINUTES=30
SCHEDULE_MAX_DAYS=30
GPS_FRESH_SECONDS=30
GPS_STALE_SECONDS=120
MIN_STOP_DISTANCE_METERS=50

# Trust proxy hop count (Cloudflare -> nginx -> app = 2). Used for client IP.
TRUSTED_PROXY_HOPS=2

// Taxi Cyprus — data model (SPEC §7)
// Concurrency invariants ("one ACTIVE assignment per booking/driver/vehicle") are
// enforced by the database via nullable+unique "active*" columns: while an assignment
// is active these equal the related id; when ended they are set NULL. Postgres allows
// many NULLs in a UNIQUE column, so ended assignments never collide, but two active
// assignments for the same driver/vehicle/booking are impossible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
  FLEET_OWNER // 2026-11-20: sees only his fleet's drivers & vehicles (read-only)
}

enum VehicleClass {
  COMFORT
  XL
}

enum BookingStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_DRIVER
}

model StaffUser {
  id                String    @id @default(uuid())
  login             String    @unique
  passwordHash      String
  role              Role
  active            Boolean   @default(true)
  sessionVersion    Int       @default(1)
  displayName       String
  // TOTP two-factor (2026-10-01 audit Stage 1.2) for ADMIN/DISPATCHER. Secrets are AES-GCM
  // encrypted at rest. totpLastStep blocks replay of an already-used code.
  totpSecret        String?
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  totpLastStep      Int?
  // The business owner (2026-11-23, operator: «только я»): an ADMIN who also sees «Бухгалтерия».
  // Never set from the admin UI — only by the migration / `npm run owner:set`.
  isOwner           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  driver   Driver?
  sessions AuthSession[]
  fleet    Fleet?
}

// A fleet owner's car park (2026-11-20, operator). The admin creates the owner and puts drivers
// and vehicles into his fleet; the owner only looks (reports, list of cars). A driver / vehicle
// without a fleet works directly for IL-Y. The owner's share (percent / rent) comes later.
model Fleet {
  id        String    @id @default(uuid())
  name      String
  owner     StaffUser @relation(fields: [ownerId], references: [id])
  ownerId   String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  drivers  Driver[]
  vehicles Vehicle[]
}

model Driver {
  id            String            @id @default(uuid())
  user          StaffUser         @relation(fields: [userId], references: [id])
  userId        String            @unique
  publicName    String
  phone         String // operational contact shown to matched passenger
  onDuty        Boolean           @default(false)
  available     Boolean           @default(false)
  active        Boolean           @default(true)
  // Operational eligibility (Task 015). LEGACY = grandfathered existing driver;
  // APPROVED = passed admin KYC review; others block new work.
  eligibility   DriverEligibility @default(PENDING)
  applicationId String? // the approved DriverApplication that provisioned this driver
  fleet         Fleet?            @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  fleetId       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Aggregate passenger rating (Task 020). ratingTotal is the SUM of stars (integer, no float
  // drift); the displayed average is ratingTotal / ratingCount. Both are maintained in the same
  // transaction that writes a TripRating, so they are always consistent with the rating rows.
  ratingTotal   Int     @default(0)
  ratingCount   Int     @default(0)
  // Driver takes co-riders on airport/intercity rides (Task 022). Off by default.
  acceptsShared Boolean @default(false)

  bindings       DriverVehicleBinding[]
  assignments    Assignment[]
  offers         DriverOffer[]
  location       LatestDriverLocation?
  dutySessions   DutySession[]
  ratings        TripRating[]
  preAssignments PreAssignment[]

  @@index([fleetId])
}

// Driver on/off-duty sessions (Task 017). Server-timestamped so online-time totals are
// authoritative (never a browser timer). At most one OPEN session per driver via the
// nullable-unique activeDriverId. Feeds Task 016 driver-utilization analytics.
model DutySession {
  id             String    @id @default(uuid())
  driver         Driver    @relation(fields: [driverId], references: [id])
  driverId       String
  onlineAt       DateTime  @default(now())
  offlineAt      DateTime?
  source         String    @default("driver") // driver | system (e.g. forced off by expiry)
  activeDriverId String?   @unique // = driverId while open; NULL when closed
  createdAt      DateTime  @default(now())

  @@index([driverId, onlineAt])
}

// Driver-reported settlement (Task 017 §5). SEPARATE from the immutable quote/Fare: it records
// the ACTUAL metered amount and (optionally) that payment was received, as driver-reported
// evidence with actor + timestamps + revision. Corrections append a new revision (never edit in
// place) with a reason; the current row is the max revision per booking. Attribution is the
// assignment that COMPLETED the trip, so a reassigned-away driver cannot settle it.
model DriverSettlement {
  id                 String    @id @default(uuid())
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId          String
  driverId           String // the completing driver (attribution)
  assignmentId       String? // the completing assignment
  reportedFinalCents Int
  currency           String    @default("EUR")
  paymentReceived    Boolean   @default(false)
  receivedAt         DateTime?
  note               String?
  revision           Int       @default(1)
  correctionReason   String?
  createdByType      String    @default("DRIVER") // DRIVER | STAFF
  createdById        String?
  createdAt          DateTime  @default(now())

  @@unique([bookingId, revision])
  @@index([driverId, createdAt])
}

enum DriverEligibility {
  LEGACY
  APPROVED
  PENDING
  SUSPENDED
  DOCUMENTS_EXPIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// A self-registering driver applicant (verified phone). NOT an operational driver until
// an admin approves their application (Task 015). Kept separate from StaffUser so an
// application can never grant privileges by itself.
model DriverApplicant {
  id              String    @id @default(uuid())
  phone           String    @unique
  phoneVerifiedAt DateTime?
  legalName       String?
  email           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  application DriverApplication?
  sessions    ApplicantSession[]
}

model ApplicantSession {
  id            String          @id @default(uuid())
  applicant     DriverApplicant @relation(fields: [applicantId], references: [id])
  applicantId   String
  sessionDigest String          @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime        @default(now())
}

// Phone OTP challenge. When Twilio Verify is configured, Twilio holds the code and
// `codeHash` is null; otherwise a dev code is hashed here (never logged in prod).
model PhoneVerification {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String?
  provider   String // 'twilio-verify' | 'dev'
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model DriverApplication {
  id             String            @id @default(uuid())
  applicant      DriverApplicant   @relation(fields: [applicantId], references: [id])
  applicantId    String            @unique
  status         ApplicationStatus @default(DRAFT)
  revision       Int               @default(1) // current editable revision
  identity       String? // JSON draft (step 2)
  driving        String? // JSON draft (step 3)
  vehicle        String? // JSON draft (step 4)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewerId     String?
  decisionReason String? // applicant-facing summary (changes/rejection)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  documents ApplicationDocument[]
  events    ApplicationEvent[]

  @@index([status, submittedAt])
}

// Uploaded document/photo metadata. Bytes live in PRIVATE storage (never public/); the
// storageKey is resolved by an authenticated stream, never a permanent public URL.
model ApplicationDocument {
  id            String            @id @default(uuid())
  application   DriverApplication @relation(fields: [applicationId], references: [id])
  applicationId String
  slot          String // id_front | id_back | passport | selfie | licence_front | ... | vehicle_front | ...
  storageKey    String
  mime          String
  sizeBytes     Int
  sha256        String
  scanStatus    String            @default("UNScanned") // UNScanned | CLEAN | INFECTED | UNAVAILABLE
  decision      String            @default("PENDING") // PENDING | ACCEPTED | CHANGES
  decisionNote  String?
  expiresAt     DateTime? // document expiry (licence/insurance/permit) — drives DOCUMENTS_EXPIRED
  revision      Int
  createdAt     DateTime          @default(now())

  @@index([applicationId, slot])
}

// Durable notification delivery (Task 013, hardened in Task 016). Enqueued INSIDE domain
// transactions; a dedicated worker CLAIMS rows with a lease (FOR UPDATE SKIP LOCKED), does
// external I/O outside the claim, then records a precise outcome. `deliveredAt` is only the
// terminal timestamp; `status` distinguishes the real outcomes so "accepted by provider" is
// never confused with "nobody subscribed", "gave up", or "superseded".
model NotificationOutbox {
  id            String    @id @default(uuid())
  audience      String // PASSENGER:<bookingId> | DRIVER:<userId>
  title         String
  body          String
  url           String
  tag           String?
  offerId       String? // bind an 'offer' notification to the exact DriverOffer it announces
  // Text key + values (2026-11-22): the service worker shows the notification in the app's / phone's
  // language (public/sw.js MSG_TEXT); title/body are the English fallback.
  msg           Json?
  dedupeKey     String?   @unique
  // PENDING | PROCESSING | SENT_TO_PROVIDER | NO_SUBSCRIBERS | RETRY | FAILED | EXPIRED | SUPERSEDED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  deliveredAt   DateTime? // terminal timestamp (any terminal state), kept for back-compat
  nextAttemptAt DateTime  @default(now())
  leaseOwner    String?
  leaseToken    String?
  leaseUntil    DateTime?
  lastError     String? // redacted last failure reason
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([deliveredAt, nextAttemptAt])
}

// ---- Task 016: durable domain-event capture + analytics delivery + telemetry ----

// Immutable domain-event fact, written IN THE SAME transaction as the business mutation
// (so a rollback removes the event too). This is the authoritative source the analytics
// exporter projects into ClickHouse. Payload is sanitized: no names/phones/street text.
model DomainEvent {
  id               String   @id @default(uuid()) // stable identity == ClickHouse dedup token
  eventType        String // booking.requested | offer.accepted | gps.sample | ...
  schemaVersion    Int      @default(1)
  aggregateType    String // booking | offer | assignment | driver | gps | provider | notification
  aggregateId      String
  aggregateVersion Int      @default(0) // booking.revision, offer seq, gps sequence, ...
  eventOrdinal     Int      @default(0) // >1 event per aggregate version → disambiguate
  occurredAt       DateTime // when it happened (domain time, UTC)
  recordedAt       DateTime @default(now()) // commit-ish time (NOT an ordering key)
  environment      String   @default("beta")
  isTest           Boolean  @default(false) // synthetic/QA data → excluded from analytics by default
  correlationId    String?
  causationId      String?
  payload          Json

  deliveries AnalyticsDelivery[]

  @@unique([aggregateType, aggregateId, aggregateVersion, eventOrdinal]) // natural idempotency key
  @@index([recordedAt])
  @@index([eventType, recordedAt])
}

// Per-sink delivery state for a DomainEvent. The event is immutable; delivery progress is
// separate so notification and analytics consumers never mark each other done. Claimed with
// a lease token; at-least-once (retry uses the same event identity → ClickHouse dedups).
model AnalyticsDelivery {
  id            String      @id @default(uuid())
  event         DomainEvent @relation(fields: [eventId], references: [id])
  eventId       String
  sink          String // 'clickhouse'
  status        String      @default("PENDING") // PENDING | PROCESSING | RETRY | DELIVERED | DEAD
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  leaseOwner    String?
  leaseToken    String?
  leaseUntil    DateTime?
  deliveredAt   DateTime?
  lastError     String? // redacted
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@unique([eventId, sink])
  @@index([sink, status, nextAttemptAt])
}

// Cross-process worker liveness. The health route reads these instead of a module-local
// timer, so a dead dedicated worker is actually detectable from the web process.
model WorkerHeartbeat {
  role      String   @id // 'dispatch' | 'notifications' | 'analytics' | 'maintenance'
  workerId  String
  beatAt    DateTime
  detail    String? // JSON: last queue depths / progress (redacted)
  updatedAt DateTime @default(now()) @updatedAt
}

// Bounded durable history of ACCEPTED GPS samples (Task 016 §5). Written in the same
// transaction that updates LatestDriverLocation; rejected/out-of-order samples never land
// here. Retention is enforced by the maintenance worker. Coordinates are restricted data.
model GpsSample {
  id         String   @id @default(uuid())
  driverId   String
  gpsSession String
  sequence   Int
  lat        Float
  lng        Float
  accuracyM  Float
  heading    Float?
  speed      Float?
  sampledAt  DateTime
  receivedAt DateTime @default(now())
  bookingId  String? // active-assignment context when known
  createdAt  DateTime @default(now())

  @@unique([driverId, gpsSession, sequence]) // stable sample identity
  @@index([driverId, sampledAt])
  @@index([receivedAt])
}

// Passenger account (Task 014). Verified phone; owns booking history / saved destinations.
model Passenger {
  id              String    @id @default(uuid())
  // Null for email-only accounts (sign-up without SMS). Only an SMS-verified number is stored.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  name            String?
  // Bolt-style consumer account (Task 018): email + password sign-in. Phone stays the verified
  // identity (SMS OTP); email is a second unique identifier, password is optional (phone-OTP-only
  // accounts have none). No KYC for passengers.
  email           String?   @unique
  passwordHash    String?
  // «Продолжить с Google / Apple» (2026-11-22): the provider's PERMANENT account id (OIDC «sub»). It never changes,
  // even when Apple hides the real e-mail — so a blocked passenger is recognised by it and cannot sign up again.
  googleSub       String?   @unique
  appleSub        String?   @unique
  // Last UI language seen when booking (2026-11-17) — used for e-mailed receipts.
  locale          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    PassengerSession[]
  savedPlaces SavedPlace[]
}

// Passenger saved places (Task 019): Home / Work quick destinations. One per kind per passenger.
model SavedPlace {
  id          String    @id @default(uuid())
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  passengerId String
  kind        String // HOME | WORK | SCHOOL | C_<id> (the passenger's own named places, 2026-11-18)
  name        String? // own name of a C_ place («Мама», «Спортзал»)
  label       String
  lat         Float
  lng         Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([passengerId, kind])
}

model PassengerSession {
  id            String    @id @default(uuid())
  passenger     Passenger @relation(fields: [passengerId], references: [id])
  passengerId   String
  sessionDigest String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model ApplicationEvent {
  id            String            @id @default(uuid())
  application   DriverApplication @relation(fields: [applicationId], references: [id])
  applicationId String
  type          String // SUBMITTED | IN_REVIEW | CHANGES_REQUESTED | REJECTED | APPROVED | DOC_DECISION | NOTE
  actorType     String // APPLICANT | ADMIN | SYSTEM
  actorId       String?
  visibility    String            @default("APPLICANT") // APPLICANT | INTERNAL
  detail        String?
  revision      Int?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model Vehicle {
  id        String       @id @default(uuid())
  plate     String       @unique
  make      String
  model     String
  color     String
  vClass    VehicleClass
  seats     Int
  active    Boolean      @default(true)
  fleet     Fleet?       @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  fleetId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bindings    DriverVehicleBinding[]
  assignments Assignment[]

  @@index([fleetId])
}

model DriverVehicleBinding {
  id        String    @id @default(uuid())
  driver    Driver    @relation(fields: [driverId], references: [id])
  driverId  String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  vehicleId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // one current binding per driver and per vehicle (NULL when ended)
  activeDriverId  String? @unique
  activeVehicleId String? @unique

  @@index([driverId])
  @@index([vehicleId])
}

model Booking {
  id                    String           @id @default(uuid())
  reference             String           @unique
  pickupLat             Float
  pickupLng             Float
  pickupLabel           String
  dropoffLat            Float
  dropoffLng            Float
  dropoffLabel          String
  dropoffPostcode       String? // 2026-11-19: area postcode for drivers (best effort)
  passengerName         String
  phone                 String
  note                  String?
  vClass                VehicleClass
  passengerCount        Int
  luggageCount          Int              @default(0) // bags; asked on pre-bookings, shown to the driver
  passengerRemindedAt   DateTime? // pre-booking: "ride in ~1 hour" reminder queued
  passengerRemind30At   DateTime? // second reminder, 30 min before (2026-11-22)
  // Opt-in live passenger position for the driver, before pickup only (2026-11-15).
  passengerLat          Float?
  passengerLng          Float?
  passengerLocAccuracyM Float?
  passengerLocAt        DateTime?
  // One optional intermediate stop (2026-11-15) and the paid waiting there.
  stopLat               Float?
  stopLng               Float?
  stopLabel             String?
  stopArrivedAt         DateTime?
  stopWaitStartedAt     DateTime?
  stopDepartedAt        DateTime?
  stopWaitCents         Int?
  passengerRating       PassengerRating?
  requestedAt           DateTime         @default(now())
  scheduledAt           DateTime?
  status                BookingStatus    @default(REQUESTED)
  revision              Int              @default(0)
  quoteId               String? // fare quote applied at booking time (Task 012)
  fareCents             Int? // snapshotted estimate total (cents)
  // Pre-booking minimum fixed AT BOOKING (operator 2026-11-23): a later price change in admin does not touch
  // existing bookings — the passenger and the driver keep the minimum that was shown when it was booked.
  fareMinCents          Int?
  fareMinZone           String?
  priceType             String? // REGULATED_METER_ESTIMATE | REGULATED_FIXED | UPFRONT_DYNAMIC
  fareBreakdown         String? // JSON snapshot of the quote breakdown
  startCode             String? // 4-digit trip-start code (shown to passenger; driver enters it to start) — M3
  arrivedAt             DateTime? // server time the driver marked ARRIVED at pickup — M3
  passengerId           String? // owning passenger account (Task 014); null for legacy/anonymous
  flightNumber          String? // optional, for airport pickups (shown to the driver; not live-tracked)
  // Ride-share «Попутчик» (Task 022): airport/intercity only, opt-in at booking.
  shareOptIn            Boolean          @default(false)
  shareMaxExtraMin      Int? // the most extra minutes this passenger accepts for a co-rider
  childCount            Int              @default(0) // of passengerCount; shown to co-riders/driver, never names
  shareFullCents        Int? // the price before the shared discount (restored if the co-rider drops out)
  shareFullPriceType    String?
  shareWaitMin          Int? // pre-booking: how long this passenger can wait for the co-rider (their choice)
  shareEarlyMin         Int? // pre-booking: how much EARLIER this passenger can leave for a co-rider (2026-11-21)
  arriveFrom            DateTime? // pre-booking «быть на месте с … до …» (2026-11-22): arrival window
  arriveBy              DateTime?
  shareOrigScheduledAt  DateTime? // the booked pickup time, if a pre-booked pair moved it (restored on break-up)
  // Airport meeting point for pairs (on 2026-11-19 18:30–19:10, then postponed until airports are set up):
  // the passenger's own pickup point, restored on break-up. Unused while the feature is off.
  shareOrigPickupLat    Float?
  shareOrigPickupLng    Float?
  shareOrigPickupLabel  String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  assignments    Assignment[]
  events         BookingEvent[]
  grants         TrackingGrant[]
  dispatchJob    DispatchJob?
  offers         DriverOffer[]
  waiting        WaitingSession?
  fare           Fare?
  messages       ChatMessage[]
  settlements    DriverSettlement[]
  rating         TripRating?
  preAssignments PreAssignment[]
  shareAsHost    ShareGroup[]       @relation("ShareHost")
  shareAsGuest   ShareGroup[]       @relation("ShareGuest")

  @@index([status, createdAt])
  @@index([status, scheduledAt])
  @@index([phone])
  @@index([passengerId, createdAt])
}

// Post-trip passenger rating of the driver (Task 020). Exactly one per completed booking
// (bookingId @unique), written once by the owning passenger. Immutable after creation — the
// honest record of how the trip was rated at the time. Stars are 1..5; tags is a JSON array of
// short slugs from a fixed vocabulary; comment is optional, length-capped at the API layer.
// Creating a row also increments the driver's ratingTotal/ratingCount in the SAME transaction.
model TripRating {
  id          String   @id @default(uuid())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String   @unique
  driver      Driver   @relation(fields: [driverId], references: [id])
  driverId    String
  passengerId String // owning passenger (scalar, matches Booking.passengerId coupling)
  stars       Int
  tags        String? // JSON array of tag slugs
  comment     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
}

// Passenger↔driver chat, scoped to one booking (Task: rider can message the driver).
// Passenger is authorized by the tracking token; driver by the active assignment.
model ChatMessage {
  id                String    @id @default(uuid())
  booking           Booking   @relation(fields: [bookingId], references: [id])
  bookingId         String
  sender            String // PASSENGER | DRIVER
  body              String
  createdAt         DateTime  @default(now())
  readByPassengerAt DateTime?
  readByDriverAt    DateTime?
  // Auto-translation (2026-11-17): sender's UI language and cached translations { "<lang>": text }.
  lang              String?
  translations      Json?

  @@index([bookingId, createdAt])
}

// Pickup waiting after ARRIVED (Task 012 §6.4). Persisted timestamps so a refresh/restart
// can never reset or double-count waiting; the clock is server-authoritative.
model WaitingSession {
  id                  String    @id @default(uuid())
  booking             Booking   @relation(fields: [bookingId], references: [id])
  bookingId           String    @unique
  arrivedAt           DateTime // when the driver arrived / free wait started
  graceSeconds        Int // free waiting window
  paidRateCentsPerMin Int // pre-pickup paid rate (0 in regulated meter mode by default)
  endedAt             DateTime? // set on trip start or cancellation
  accruedCents        Int       @default(0) // finalized paid-wait amount once ended
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Immutable fare record written once at COMPLETED (Task 012 §6.4). Payment collection
// status is tracked separately from trip completion (payment to driver, cash by default).
model Fare {
  id               String   @id @default(uuid())
  booking          Booking  @relation(fields: [bookingId], references: [id])
  bookingId        String   @unique
  priceType        String // REGULATED_METER_ESTIMATE | REGULATED_FIXED | UPFRONT_DYNAMIC
  currency         String   @default("EUR")
  estimateCents    Int? // quoted estimate at booking time
  waitingCents     Int      @default(0)
  adjustmentsCents Int      @default(0)
  finalCents       Int? // authoritative final amount where captured; null = follow meter/estimate
  basis            String // JSON: estimate vs final basis + breakdown snapshot
  paymentMethod    String   @default("CASH_TO_DRIVER")
  paymentStatus    String   @default("PENDING") // PENDING | COLLECTED (never auto-COLLECTED on COMPLETED)
  // GPS taximeter at completion (2026-11-19) — recorded for comparison with the car's taximeter;
  // not charged. km = charged by distance; slowSec = charged by time; gapSec = no GPS (estimated).
  gpsMeterCents    Int?
  gpsMeterKm       Float?
  gpsMeterSlowSec  Int?
  gpsMeterGapSec   Int?
  createdAt        DateTime @default(now())
}

// Fixed airport fares (2026-11-17): the operator draws a zone on the map in admin and sets the
// price; a trip between that airport and a point inside the zone (either direction, no stop)
// is priced REGULATED_FIXED at exactly this amount instead of the meter estimate.
model FixedFareZone {
  id           String   @id @default(uuid())
  airport      String // AIRPORTS code: PFO | LCA
  name         String
  // [[lat, lng], …] closed implicitly; ≥ 3 points.
  polygon      Json
  // 2026-11-21 (operator): fixed price by POSTCODE — the address's 4-digit Cyprus postcode is in this list (e.g. 8560).
  // A postcode zone has an empty polygon and wins over drawn zones.
  postcodes    String[] @default([])
  comfortCents Int
  xlCents      Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([airport, active])
}

// Pre-booking minimum fare by area (2026-11-22, operator): a pre-booked ride with pickup AND drop-off inside
// the area costs at least this (Comfort / XL); above it the taximeter counts. Drawn in admin «Минимум предзаказа».
model MinFareZone {
  id           String   @id @default(uuid())
  name         String
  polygon      Json // [[lat, lng], …] ≥ 3 points
  comfortCents Int
  xlCents      Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// E-mailed trip receipt (2026-11-17). One row per completed booking, written in the completion
// transaction (outbox); the worker sends it through the e-mail provider. A passenger "send again"
// request puts the same row back to PENDING (resendCount is capped).
model ReceiptEmail {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  passengerId       String
  toEmail           String
  locale            String    @default("en")
  // PENDING | PROCESSING | RETRY | SENT | FAILED | SKIPPED
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  resendCount       Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([passengerId])
}

// Durable per-booking dispatch attempt (Task 012 §4). The background worker leases a
// job, offers eligible drivers one at a time, and gives up at the deadline (NO_DRIVER).
model DispatchJob {
  id             String    @id @default(uuid())
  booking        Booking   @relation(fields: [bookingId], references: [id])
  bookingId      String    @unique
  deadlineAt     DateTime
  triedDriverIds String[]  @default([])
  radiusStage    Int       @default(0)
  // Set when automatic offers to nearby drivers are exhausted: the ride is then on the drivers'
  // free-orders board until deadlineAt (FREE_BOARD_SEC), after which it becomes NO_DRIVER.
  openedAt       DateTime?
  leaseOwner     String?
  leaseUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leaseUntil])
  @@index([openedAt])
}

// An expiring offer to a single reserved driver. active* nullable-unique columns give
// DB-enforced "one active offer per booking and per driver", reserving capacity so a
// driver can't be double-offered or assigned elsewhere while an offer is outstanding.
model DriverOffer {
  id              String    @id @default(uuid())
  booking         Booking   @relation(fields: [bookingId], references: [id])
  bookingId       String
  driver          Driver    @relation(fields: [driverId], references: [id])
  driverId        String
  vehicleId       String
  pickupEtaSec    Int?
  pickupDistanceM Int?
  status          String    @default("OFFERED") // OFFERED | ACCEPTED | REJECTED | EXPIRED | CANCELED
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?

  activeBookingId String? @unique
  activeDriverId  String? @unique

  @@index([bookingId])
  @@index([driverId])
}

model Assignment {
  id        String  @id @default(uuid())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String
  driver    Driver  @relation(fields: [driverId], references: [id])
  driverId  String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  // Historical snapshots captured at assignment time (SPEC §4)
  driverPublicName String
  driverPhone      String
  vehiclePlate     String
  vehicleMake      String
  vehicleModel     String
  vehicleColor     String
  vehicleClass     VehicleClass

  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  actor      String
  reason     String?

  // active* columns enforce single active assignment per booking/driver/vehicle
  activeBookingId String? @unique
  activeDriverId  String? @unique
  activeVehicleId String? @unique

  @@index([bookingId])
  @@index([driverId])
}

model BookingEvent {
  id           String   @id @default(uuid())
  booking      Booking  @relation(fields: [bookingId], references: [id])
  bookingId    String
  type         String
  actorType    String // STAFF | DRIVER | PASSENGER | SYSTEM
  actorId      String?
  beforeStatus String?
  afterStatus  String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([bookingId, createdAt])
}

// Web Push subscription. `audience` scopes who a message notifies:
//   PASSENGER:<bookingId>  — the rider on that booking (tracking-token authorized)
//   DRIVER:<userId>        — a specific driver account
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  audience  String
  createdAt DateTime @default(now())

  @@index([audience])
}

model LatestDriverLocation {
  driver     Driver   @relation(fields: [driverId], references: [id])
  driverId   String   @id
  lat        Float
  lng        Float
  accuracyM  Float
  heading    Float?
  speed      Float?
  sampledAt  DateTime
  receivedAt DateTime @default(now())
  gpsSession String
  sequence   Int
}

model TrackingGrant {
  id          String    @id @default(uuid())
  booking     Booking   @relation(fields: [bookingId], references: [id])
  bookingId   String
  tokenDigest String    @unique
  // FULL = the passenger's private link (cancel, chat, start code). VIEW = a read-only "share my
  // trip" link (live position + driver/car only) that can never be exchanged for FULL access.
  scope       String    @default("FULL")
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([bookingId])
}

model AuthSession {
  id             String    @id @default(uuid())
  sessionDigest  String    @unique
  user           StaffUser @relation(fields: [userId], references: [id])
  userId         String
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model IdempotencyReceipt {
  id           String   @id @default(uuid())
  scope        String
  key          String
  requestHash  String
  responseJson String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([scope, key])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String // JSON-encoded value
  updatedAt DateTime @updatedAt
}

// Server-issued, persisted fare quote (Task 012 §6). Immutable snapshot bound to the
// normalized request; the client-supplied price is never authoritative.
model Quote {
  id              String       @id @default(uuid())
  pickupLat       Float
  pickupLng       Float
  dropoffLat      Float
  dropoffLng      Float
  vClass          VehicleClass
  passengerCount  Int
  luggageCount    Int          @default(0)
  distanceMeters  Int
  durationSeconds Int
  priceType       String
  ruleVersion     String
  currency        String       @default("EUR")
  totalCents      Int
  rangeLowCents   Int
  rangeHighCents  Int
  breakdown       String // JSON fare lines
  requestHash     String // hash of the normalized inputs; booking re-verifies
  pricingAt       DateTime? // the intended JOURNEY time priced (scheduled → future; else = createdAt)
  routeSource     String? // 'traffic' | 'approx' — provenance of distance/duration
  minCents        Int? // pre-booking minimum of the area at quote time (2026-11-23), null = none
  minZone         String?
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  @@index([createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole String?
  action    String
  target    String?
  detail    String? // redacted, no secrets
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Fixed-window rate-limit counters (2026-10-01 audit Stage 1.1). Incremented atomically with a
// single INSERT … ON CONFLICT DO UPDATE … RETURNING so concurrent bursts are all counted; expired
// rows are pruned by maintenance. Replaces the old non-atomic `ratelimit:*` rows in Setting.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Pre-assignment of a SCHEDULED ride to a driver who committed to it in advance (airport transfers
// etc.). A commitment does NOT make the driver busy now (Task 012 §4.4: never hold a free driver for
// hours); the worker converts it into a real Assignment shortly before pickup if the driver is free,
// otherwise it lapses and the ride falls back to normal automatic search. One live commitment per
// booking (activeBookingId @unique, like offers/assignments); per-driver overlap and count limits are
// enforced under the driver row lock.
model PreAssignment {
  id              String    @id @default(uuid())
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId       String // history: a released/lapsed commitment can be followed by a new one
  driver          Driver    @relation(fields: [driverId], references: [id])
  driverId        String
  vehicleId       String
  pickupAt        DateTime // booking.scheduledAt at commit time
  status          String    @default("COMMITTED") // COMMITTED | CONVERTED | RELEASED | LAPSED
  committedAt     DateTime  @default(now())
  remindedAt      DateTime?
  remind35At      DateTime? // second driver reminder, 35 min before (2026-11-22)
  endedAt         DateTime?
  endReason       String?
  activeBookingId String?   @unique

  @@index([bookingId])
  @@index([driverId, status, pickupAt])
  @@index([status, pickupAt])
}

// Driver's 1–5 star rating of the passenger after a completed ride (2026-11-15). One per booking.
model PassengerRating {
  id          String   @id @default(uuid())
  booking     Booking  @relation(fields: [bookingId], references: [id])
  bookingId   String   @unique
  driverId    String
  passengerId String?
  stars       Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([passengerId])
}

/// Own Cyprus address base from OpenStreetMap (2026-11-19). Rows of one import share `batch`
/// (= OsmImport.id); search reads the latest DONE batch. Trigram index on `search` is created in
/// the migration SQL (prisma has no syntax for it).
model OsmPlace {
  batch         Int
  id            String
  kind          String
  name          String
  street        String?
  housenumber   String?
  locality      String?
  postcode      String?
  postcodeExact Boolean @default(false)
  lat           Float
  lng           Float
  importance    Int
  search        String
  nameFold      String

  @@id([batch, id])
  @@index([batch, lat, lng])
}

/// Weekly OpenStreetMap import runs (2026-11-19).
model OsmImport {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("RUNNING")
  rows         Int?
  withPostcode Int?
  error        String?
}

// Ride-share «Попутчик» (Task 022). Two bookings in one car, at most.
//  LIVE    — host is already on a trip (assigned…in progress); a new guest booking fits the route.
//            The host passenger and the driver answer within answerSec; the guest opted in at booking.
//  PREBOOK — two pre-bookings fit each other; both passengers answer, then the pair is one order on
//            the drivers' pre-booking board. Passengers never see each other's name/phone/address.
// status: PROPOSED → ACCEPTED (live: guest attached) | MATCHED (prebook: waiting for a driver)
//         → ENDED; or DECLINED / EXPIRED / CANCELED. active*BookingId nullable-unique = one live
//         group per booking.
model ShareGroup {
  id                   String    @id @default(uuid())
  mode                 String // LIVE | PREBOOK
  status               String    @default("PROPOSED")
  host                 Booking   @relation("ShareHost", fields: [hostBookingId], references: [id], onDelete: Cascade)
  hostBookingId        String
  guest                Booking   @relation("ShareGuest", fields: [guestBookingId], references: [id], onDelete: Cascade)
  guestBookingId       String
  driverId             String? // LIVE: the host's driver
  discountPct          Int
  extraMinHost         Int // extra minutes for the host passenger
  extraMinGuest        Int // extra minutes for the guest vs a direct ride
  extraMinDriver       Int // extra minutes on the driver's whole remaining trip
  hostFullCents        Int
  guestFullCents       Int
  hostCents            Int // after discount
  guestCents           Int
  plan                 Json // ordered stops: [{ kind: 'pickup'|'dropoff', who: 'host'|'guest' }]
  // Minutes from the plan start (live: proposal time; pre-booking: startAt) to each passenger's
  // drop-off, the co-rider's pickup and the end of the trip — road time with traffic when Google is on.
  arrivals             Json?
  startAt              DateTime? // pre-booked pair: when the car leaves the first pickup
  roadRouted           Boolean   @default(false)
  hostAnswer           String? // YES | NO
  guestAnswer          String?
  driverAnswer         String?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  decidedAt            DateTime?
  endedAt              DateTime?
  endReason            String?
  // Pre-booking no-show (driver waited, passenger never came): that passenger owes a part of their
  // shared price (card charge once card payments exist); the other passenger pays the full price.
  noShowBookingId      String?
  noShowFeeCents       Int?
  activeHostBookingId  String?   @unique
  activeGuestBookingId String?   @unique

  @@index([status, expiresAt])
  @@index([guestBookingId])
  @@index([hostBookingId])
}

// Owner's bookkeeping (2026-11-23, operator): income and expenses in euro, entered by hand for now
// (driver subscriptions / commission will be added automatically later), with receipts and
// recurring items (Apple, server, domain …). Only the owner (StaffUser.isOwner) sees it.
enum LedgerKind {
  INCOME
  EXPENSE
}

enum LedgerEvery {
  MONTH
  YEAR
}

model LedgerEntry {
  id           String     @id @default(uuid())
  kind         LedgerKind
  /// Calendar day of the payment (Cyprus date), stored as midnight UTC of that day.
  day          DateTime   @db.Date
  amountCents  Int
  category     String
  counterparty String?
  method       String?
  note         String?
  receiptKey   String?
  receiptMime  String?
  recurringId  String?
  createdById  String
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  recurring LedgerRecurring? @relation(fields: [recurringId], references: [id])

  @@unique([recurringId, day])
  @@index([day])
}

model LedgerRecurring {
  id           String      @id @default(uuid())
  kind         LedgerKind
  amountCents  Int
  category     String
  counterparty String?
  method       String?
  note         String?
  every        LedgerEvery
  /// The next day an entry is due (materialised when the owner opens the page).
  nextDay      DateTime    @db.Date
  active       Boolean     @default(true)
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  entries LedgerEntry[]
}

// «Журнал изменений» (2026-11-23, operator: «все изменения с уведомлением суперадмину»). Every
// changing request (POST / PUT / PATCH / DELETE) by an admin who is not the owner is written here
// and announced to the owner by push. Recorded when the request is let in (requireStaff).
model StaffAction {
  id        String    @id @default(uuid())
  actorId   String
  actorName String
  actorRole String
  method    String
  path      String
  status    Int?
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([seenAt])
}

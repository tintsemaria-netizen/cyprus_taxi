# ---- IL-Y Taxi Cyprus configuration (no secrets committed) ----
# Values here are placeholders. Real secrets live only on the server (deploy/.env.production) or in
# GitHub Secrets — never in Git and never in chat. Updated for the launch fixes (2026-11-20).

# ===== Required (the app refuses to start without them when APP_ENV=production) =====
DATABASE_URL=postgresql://taxi:CHANGE_ME@localhost:5432/taxi_cyprus?schema=public
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX
TRACKING_RECEIPT_SECRET=CHANGE_ME_64_HEX

# ===== Environment and service switches =====
# beta | production. production = commercial service: test OTP codes refused, staff MFA enforced,
# boot fails without the required secrets. Enrol every admin/dispatcher in MFA BEFORE switching.
APP_ENV=beta
APP_BASE_URL=https://il-y.taxi
# Extra hosts allowed in absolute links (comma-separated).
APP_ALLOWED_HOSTS=
# on = passenger TEST mode: orders without an SMS-verified phone (guest orders). Never for real
# passengers. Off (default) = a real order needs an SMS-verified account phone.
PASSENGER_TEST_MODE=
# on = ride-share offered. Off (default) = opt-ins ignored, no new pairs; old proposals can only
# be declined. See docs/PILOT_RUNBOOK.md before switching on.
SHARE_ENABLED=
# true = staff MFA enforced outside production too (always enforced in production).
STAFF_MFA_ENFORCE=
# calc = commission ledger in CALCULATION mode (no approved rate; nothing is demanded from
# drivers). Anything else = off.
COMMISSION_MODE=
# DEMO_MODE=true allows place/route fixtures. Set false for the pilot.
DEMO_MODE=false

# ===== Passenger phone verification / driver sign-in (Twilio Verify) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Test codes without SMS — only for the listed E.164 numbers, never in production.
SMS_ALLOW_DEV_OTP=false
SMS_DEV_OTP_ALLOWLIST=

# ===== Driver documents (KYC) =====
PRIVATE_UPLOAD_DIR=/app/private-uploads
# ClamAV clamd. Without it documents cannot be accepted or approved.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Retention of rejected applications and abandoned drafts (days).
KYC_REJECTED_RETENTION_DAYS=
KYC_DRAFT_RETENTION_DAYS=

# ===== Receipt e-mail (Resend). Without it receipts stay in the app; due e-mails are skipped. =====
RESEND_API_KEY=
EMAIL_FROM="IL-Y <receipts@il-y.taxi>"
EMAIL_REPLY_TO=

# ===== Web push (VAPID) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@il-y.taxi

# ===== Maps =====
# Browser key (website-restricted) and a separate server key for Routes/Geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_MAP_STYLE=demo-raster
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_TILES_LIGHT=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Place search: osm (own Cyprus base) | google | empty (fixtures).
GEOCODER_PROVIDER=osm
OSM_IMPORT=
OSM_SOURCES=

# ===== Capacity, scheduling, GPS =====
LUGGAGE_MAX_COMFORT=4
LUGGAGE_MAX_XL=7
SCHEDULE_MIN_MINUTES=30
SCHEDULE_MAX_DAYS=30
GPS_FRESH_SECONDS=30
GPS_STALE_SECONDS=120
GPS_RETENTION_DAYS=7
MIN_STOP_DISTANCE_METERS=50
# Dispatch tunables (DISPATCH_*, PREASSIGN_*, SHARE_*) have code defaults — see src/lib/config.ts.
DISPATCH_GPS_LOSS_REMATCH_SECONDS=90

# ===== Network / process =====
# Cloudflare -> nginx -> app: one trusted hop.
TRUSTED_PROXY_HOPS=1
# Dedicated worker container owns the dispatch loop (WORKER_ROLE=worker there).
DEDICATED_WORKERS=true
WORKER_ROLE=
DISPATCH_WORKER=

# ===== Analytics (ClickHouse, private network). Empty = analytics off; bookings unaffected. =====
CLICKHOUSE_URL=
CLICKHOUSE_DB=taxi_analytics
CLICKHOUSE_WRITE_USER=taxi_writer
CLICKHOUSE_WRITE_PASSWORD=
CLICKHOUSE_READ_USER=taxi_reader
CLICKHOUSE_READ_PASSWORD=
